# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed front-end origins (required in production)
CORS_ORIGIN=http://localhost:4200

# MySQL Database (DB_NAME and DB_USER are required; no default credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my-api
DB_USER=root
DB_PASSWORD=change_me
